[... ELLIPSIZATION ...]RkfEFkZC1NZW1iZXIgLUZvcmNlIE5vdGVQcm9wZXJ0eSBzdG9wcGVkX2F0ICgoR2V0LURhdGUpLlRvVW5pdmVyc2FsVGltZSgpLlRvU3RyaW5nKCdvJykpOyRkfENvbnZlcnRUby1Kc29uIC1EZXB0aCA2fFNldC1Db250ZW50IC1FbmNvZGluZyBVVEY4ICRSdW50aW1lCldyaXRlLUhvc3QgJ0VEVUFMQ19MT0NBTF9TVE9QUEVEJwo='))
          New-Item -ItemType Directory -Force (Split-Path (Join-Path $src 'CORE\verify_local_edualc.py') -Parent)|Out-Null;[IO.File]::WriteAllBytes((Join-Path $src 'CORE\verify_local_edualc.py'),[Convert]::FromBase64String(''))
          New-Item -ItemType Directory -Force (Split-Path (Join-Path $src 'CONFIG\NODE_FINGERPRINTS.json') -Parent)|Out-Null;[IO.File]::WriteAllBytes((Join-Path $src 'CONFIG\NODE_FINGERPRINTS.json'),[Convert]::FromBase64String(''))
          New-Item -ItemType Directory -Force (Split-Path (Join-Path $src 'CONFIG\TRINITY_FUNCTION_REGISTRY.json') -Parent)|Out-Null;[IO.File]::WriteAllBytes((Join-Path $src 'CONFIG\TRINITY_FUNCTION_REGISTRY.json'),[Convert]::FromBase64String(''))
          New-Item -ItemType Directory -Force (Split-Path (Join-Path $src 'CONFIG\FARADAY_CAGE_ANCHOR.json') -Parent)|Out-Null;[IO.File]::WriteAllBytes((Join-Path $src 'CONFIG\FARADAY_CAGE_ANCHOR.json'),[Convert]::FromBase64String(''))
          $modelDir=Join-Path $src 'EDUALC\MODELS\LOW';New-Item -ItemType Directory -Force $modelDir|Out-Null
          $model=Join-Path $modelDir 'Qwen3.5-0.8B-Q4_0.gguf'
          Invoke-WebRequest -UseBasicParsing -Uri 'https://huggingface.co/ggml-org/Qwen3.5-0.8B-GGUF/resolve/main/Qwen3.5-0.8B-Q4_0.gguf?download=true' -OutFile $model
          if((Get-FileHash -Algorithm SHA256 $model).Hash.ToLowerInvariant() -ne '57d1997790d1744fba5b40a7317df71ea5e2acee28c47e78f0cce39c0703f8cf'){throw 'model hash mismatch'}
          $zip=Join-Path $env:RUNNER_TEMP 'llama-win.zip'
          Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/ggml-org/llama.cpp/releases/download/b10621/llama-b10621-bin-win-cpu-x64.zip' -OutFile $zip
          if((Get-FileHash -Algorithm SHA256 $zip).Hash.ToLowerInvariant() -ne '0e8b65e650e369f70f8307d890508886f171ef4fb00facccddd4a1b7ffdaca51'){throw 'runtime archive hash mismatch'}
          $rt=Join-Path $src 'EDUALC\RUNTIMES\LLAMA\WINDOWS_X64_CPU';New-Item -ItemType Directory -Force $rt|Out-Null;Expand-Archive -Force $zip $rt
      - name: Install start infer reinstall infer and prove Windows behavior
        shell: pwsh
        run: |
          $ErrorActionPreference='Stop'
          $src=Join-Path $env:RUNNER_TEMP 'r4src'
          & cmd.exe /c (Join-Path $src 'INSTALL_TRINITY.cmd');if($LASTEXITCODE -ne 0){throw 'first install failed'}
          $cands=@('D:\TRINITY\universal',(Join-Path $env:ProgramData 'TRINITY\universal'),(Join-Path $env:LOCALAPPDATA 'TRINITY\universal'))
          $dest=$cands|Where-Object{Test-Path (Join-Path $_ 'STATE\install\current.json')}|Select-Object -First 1;if(!$dest){throw 'destination not found'}
          & cmd.exe /c (Join-Path $dest 'START_TRINITY.cmd');if($LASTEXITCODE -ne 0){throw 'START TRINITY failed'}
          & python.exe (Join-Path $dest 'CORE\verify_local_edualc.py') --root $dest;if($LASTEXITCODE -ne 0){throw 'first inference failed'}
          $r=Get-Content -Raw (Join-Path $dest 'STATE\edualc\runtime.json')|ConvertFrom-Json;if(!$r.owned_process -or $r.reused_existing){throw 'ownership lost after START TRINITY'}
          'PERSIST_ME'|Set-Content (Join-Path $dest 'STATE\ci_marker.txt');$pid1=$r.pid
          Start-Sleep -Seconds 1
          & cmd.exe /c (Join-Path $src 'INSTALL_TRINITY.cmd');if($LASTEXITCODE -ne 0){throw 'second install failed'}
          if((Get-Content -Raw (Join-Path $dest 'STATE\ci_marker.txt')).Trim() -ne 'PERSIST_ME'){throw 'state marker lost'}
          & python.exe (Join-Path $dest 'CORE\verify_local_edualc.py') --root $dest;if($LASTEXITCODE -ne 0){throw 'second inference failed'}
          $r2=Get-Content -Raw (Join-Path $dest 'STATE\edualc\runtime.json')|ConvertFrom-Json;if(!$r2.owned_process -or $r2.reused_existing){throw 'ownership lost after reinstall'};if([int]$r2.pid -eq [int]$pid1){throw 'owned process was not restarted during replacement'}
          $j=Get-Content -Raw (Join-Path $dest 'STATE\install\current.json')|ConvertFrom-Json;if(!(Test-Path $j.desktop_launcher)){throw 'desktop launcher missing'}
          foreach($d in @('CORE','CONFIG','APPS','POLICY','COMPONENTS','TOOLS','ADDONS','UPDATES')){if(!(Test-Path (Join-Path $j.backup_root $d))){throw "backup missing $d"}}
          if(!(Test-Path (Join-Path $dest 'EDUALC\MODELS\LOW\Qwen3.5-0.8B-Q4_0.gguf'))){throw 'installed model missing'}
          & powershell.exe -NoProfile -ExecutionPolicy Bypass -File (Join-Path $dest 'CORE\stop_local_edualc_windows.ps1') -Root $dest
          Write-Host "WINDOWS_R4_NATIVE_PASS dest=$dest pid1=$pid1 pid2=$($r2.pid) desktop=$($j.desktop_launcher)"
  ubuntu:
    runs-on: ubuntu-latest
    timeout-minutes: 35
    steps:
      - name: Build exact R4 executable fixture and verified payload
        shell: bash
        run: |
          set -euo pipefail
          src="$RUNNER_TEMP/r4src"; mkdir -p "$src"
          for d in APPS POLICY COMPONENTS TOOLS ADDONS UPDATES; do mkdir -p "$src/$d"; echo fixture > "$src/$d/fixture.txt"; done
          tar -xzf <(base64 -d "$GITHUB_WORKSPACE/ci/trinity_r4_exec_fixture.b64") -C "$src"
          chmod +x "$src/INSTALL_TRINITY.sh" "$src/START_TRINITY.sh" "$src/CORE/install_linux.sh" "$src/CORE/start_local_edualc.py" "$src/CORE/stop_local_edualc.py" "$src/CORE/verify_local_edualc.py"
          mkdir -p "$src/EDUALC/MODELS/LOW" "$src/EDUALC/RUNTIMES/LLAMA/LINUX_X64_CPU"
          curl -fL --retry 4 -o "$src/EDUALC/MODELS/LOW/Qwen3.5-0.8B-Q4_0.gguf" 'https://huggingface.co/ggml-org/Qwen3.5-0.8B-GGUF/resolve/main/Qwen3.5-0.8B-Q4_0.gguf?download=true'
          echo '57d1997790d1744fba5b40a7317df71ea5e2acee28c47e78f0cce39c0703f8cf  '$src'/EDUALC/MODELS/LOW/Qwen3.5-0.8B-Q4_0.gguf' | sha256sum -c -
          curl -fL --retry 4 -o "$RUNNER_TEMP/llama-linux.tar.gz" 'https://github.com/ggml-org/llama.cpp/releases/download/b10621/llama-b10621-bin-ubuntu-x64.tar.gz'
          echo '91d7b03ddae498a39f28fdb85d84d2b4a0fd3838d10b4f897e0ef8975bb9b583  '$RUNNER_TEMP'/llama-linux.tar.gz' | sha256sum -c -
          tar -xzf "$RUNNER_TEMP/llama-linux.tar.gz" -C "$src/EDUALC/RUNTIMES/LLAMA/LINUX_X64_CPU"
      - name: Install start infer reinstall infer and prove Ubuntu behavior
        shell: bash
        run: |
          set -euo pipefail
          src="$RUNNER_TEMP/r4src"; export HOME="$RUNNER_TEMP/home" TRINITY_HOME="$RUNNER_TEMP/trinity"; mkdir -p "$HOME"
          sh "$src/INSTALL_TRINITY.sh"
          sh "$TRINITY_HOME/START_TRINITY.sh"
          python3 "$TRINITY_HOME/CORE/verify_local_edualc.py" --root "$TRINITY_HOME"
          python3 - <<'PY'
          import json,os
          d=json.load(open(os.environ['TRINITY_HOME']+'/STATE/edualc/runtime.json'))
          assert d['owned_process'] is True and d['reused_existing'] is False,d
          open(os.environ['TRINITY_HOME']+'/STATE/ci_marker.txt','w').write('PERSIST_ME\n')
          open(os.environ['RUNNER_TEMP']+'/pid1.txt','w').write(str(d['pid']))
          PY
          sleep 1
          sh "$src/INSTALL_TRINITY.sh"
          test "$(cat "$TRINITY_HOME/STATE/ci_marker.txt")" = PERSIST_ME
          python3 "$TRINITY_HOME/CORE/verify_local_edualc.py" --root "$TRINITY_HOME"
          python3 - <<'PY'
          import glob,json,os
          D=os.environ['TRINITY_HOME']; pid1=int(open(os.environ['RUNNER_TEMP']+'/pid1.txt').read()); r=json.load(open(D+'/STATE/edualc/runtime.json')); j=json.load(open(D+'/STATE/install/current.json'))
          assert r['owned_process'] is True and r['reused_existing'] is False,r
          assert int(r['pid']) != pid1,(pid1,r['pid'])
          assert os.path.exists(j['desktop_launcher']),j['desktop_launcher']
          for d in ['CORE','CONFIG','APPS','POLICY','COMPONENTS','TOOLS','ADDONS','UPDATES']: assert os.path.isdir(os.path.join(j['backup_root'],d)),(j['backup_root'],d)
          assert os.path.isfile(D+'/EDUALC/MODELS/LOW/Qwen3.5-0.8B-Q4_0.gguf')
          print(f"UBUNTU_R4_NATIVE_PASS dest={D} pid1={pid1} pid2={r['pid']} desktop={j['desktop_launcher']}")
          PY
          python3 "$TRINITY_HOME/CORE/stop_local_edualc.py" --root "$TRINITY_HOME"
          pkill -f "$TRINITY_HOME/CORE/edualc_captain.py" || true
